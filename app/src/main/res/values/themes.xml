<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HabitFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.HabitFlow.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A14</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.HabitFlow</item>
    </style>
</resources>
